% (gerado a partir de minerva-sem-letras.pdf). Pode ser redefinido no documento.
\newcommand{\poliBrasao}{logospoli/minerva-sem-letras-azul}
\newcommand{\poliOpacidadeBrasao}{0.14}
\newcommand{\poliBarraLogo}{logospoli/usp+polibarra}
\newcommand{\poliImgCabecalho}{logospoli/nome-colorido}

% --- 10. CAPA ---
% A capa segue a grade do miolo: mesma mancha (126 mm, à esquerda em 42 mm),
% texto alinhado à esquerda, Fira Sans nos títulos e XCharter no texto, e um
% fio azulpoli pendurado na margem como os números de seção.
%
%   cabeçalho  o filete amarelo do nome cai na altura do filete do cabeçalho
%              do miolo; o departamento, em Copperplate, completa a assinatura
%   título     última linha de base em 1/phi^2 da folha (0,382)
%   Minerva    à direita da mancha, entre a base do título e o filete
%   filete     em 1 - 1/(2 phi) da folha (0,691); disciplina, autores e data
%              descem a partir dele
\newlength{\poliCapaX}
\newlength{\poliCapaReguaCabecalho}
\newlength{\poliCapaBaseTitulo}
\newlength{\poliCapaFilete}
\newlength{\poliCapaAlturaBrasao}
\newsavebox{\poliCaixaTitulo}
\AtBeginDocument{%
  \setlength{\poliCapaX}{\dimexpr(\paperwidth-\textwidth)/2\relax}%
  \setlength{\poliCapaReguaCabecalho}{%
    \dimexpr 1in+\voffset+\topmargin+\headheight\relax}%
  \setlength{\poliCapaBaseTitulo}{0.381966\paperheight}%
  \setlength{\poliCapaFilete}{0.690983\paperheight}%
  \setlength{\poliCapaAlturaBrasao}{%
    \dimexpr\poliCapaFilete-\poliCapaBaseTitulo-8mm\relax}%
}

% Coloca #4 com o canto #3 (ex.: lb, lt, rt) no ponto (#1, #2 a partir do topo).
\newcommand{\poli@capaEm}[4]{%
  \AddToShipoutPictureFG*{\AtPageUpperLeft{%
    \put(\LenToUnit{#1},\LenToUnit{-#2}){\makebox(0,0)[#3]{#4}}}}%
}

\newcommand{\poliFonteTituloCapa}{\sffamily\bfseries\fontsize{28}{32}\selectfont}
\newcommand{\poliFonteSubtituloCapa}{\sffamily\fontseries{l}\selectfont
  \fontsize{15}{18}\selectfont}

\newcommand{\MarcaAguaCapa}{%
  \AddToShipoutPictureBG*{\AtPageUpperLeft{%
    \put(\LenToUnit{\poliCapaX+\textwidth},\LenToUnit{-\poliCapaBaseTitulo}){%
      \makebox(0,0)[rt]{{\transparent{\poliOpacidadeBrasao}%
        \includegraphics[height=\poliCapaAlturaBrasao]{\poliBrasao}}}}}}%
}

\renewcommand{\maketitle}{%
  \begin{titlepage}
    \microtypesetup{activate=false}%
    \MarcaAguaCapa

    % Cabeçalho
    \poli@capaEm{\poliCapaX}{\poliCapaReguaCabecalho}{lb}{%
      \includegraphics[width=\textwidth]{\poliImgCabecalho}}%
    \poli@capaEm{\poliCapaX}{\dimexpr\poliCapaReguaCabecalho+5mm\relax}{lb}{%
      {\fonteCapa\fontsize{8}{10}\selectfont\color{cinzasecundario}%
        \poliDepartamentoSalvo}}%

    % Título, com o fio pendurado na margem
    \sbox{\poliCaixaTitulo}{\parbox[b]{\textwidth}{\raggedright
      \poliFonteTituloCapa\color{azulpoli}\poliTituloSalvo}}%
    \poli@capaEm{\poliCapaX}{\poliCapaBaseTitulo}{lb}{%
      \llap{\color{azulpoli}\rule[-\dp\poliCaixaTitulo]{1.6pt}{%
        \dimexpr\ht\poliCaixaTitulo+\dp\poliCaixaTitulo\relax}\hspace{5mm}}%
      \usebox{\poliCaixaTitulo}}%

    % Subtítulo: largura 1/phi da mancha, para não invadir a Minerva
    \ifthenelse{\boolean{temSubtitulo}}{%
      \poli@capaEm{\poliCapaX}{\dimexpr\poliCapaBaseTitulo+12mm\relax}{lt}{%
        \parbox[t]{0.618034\textwidth}{\raggedright
          \poliFonteSubtituloCapa\poliSubtituloSalvo}}%
    }{}%

    % Filete, disciplina, autores e data
    \poli@capaEm{\poliCapaX}{\poliCapaFilete}{lt}{%
      \parbox[t]{\textwidth}{\raggedright
        \rule{\textwidth}{0.4pt}\par\vspace{5mm}%
        \ifthenelse{\equal{\poliDisciplinaSalva}{}}{}{%
          {\sffamily\bfseries\fontsize{9}{11}\selectfont\color{azulpoli}%
            \poliDisciplinaSalva\par}\vspace{3mm}}%
        \poliBlocoAutores\vspace{4mm}%
        {\sffamily\fontsize{9}{11}\selectfont\color{cinzasecundario}%
          \poliDataSalva\par}}}%

    % As camadas acima precisam de uma página de conteúdo para serem enviadas.
    \null
  \end{titlepage}
  \clearpage
}

