  \fi
\fi

% --- 8. TABELAS AUXILIARES ---
% Todas usam tabularx: colunas X dividem o espaço restante automaticamente.
% Y acrescenta alinhamento à esquerda, evitando os vãos entre palavras que o
% texto justificado abre em colunas estreitas com termos técnicos.
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\poliCabTabela}[1]{{\sffamily\small\bfseries #1}}
\setlength{\heavyrulewidth}{.7pt}
\setlength{\lightrulewidth}{.35pt}
\setlength{\cmidrulewidth}{.35pt}
\renewcommand{\arraystretch}{1.12}

% \tabelaSimulacao{<caption>}{<label>}{<linhas>}
\newcommand{\tabelaSimulacao}[3]{%
  \begin{table}[htbp]
    \centering
    \caption{#1}\label{#2}
    \begin{tabularx}{\textwidth}{@{}cYYYY@{}}
      \toprule
      \poliCabTabela{Caso} & \poliCabTabela{Operação} & \poliCabTabela{Sinais de entrada} &
      \poliCabTabela{Resultado esperado} & \poliCabTabela{Resultado observado} \\
      \midrule
      #3
      \bottomrule
    \end{tabularx}
  \end{table}%
}

% \tabeladuas{<caption>}{<label>}{<col1>}{<col2>}{<linhas>}
\newcommand{\tabeladuas}[5]{%
  \begin{table}[htbp]
    \centering
    \caption{#1}\label{#2}
    \begin{tabularx}{\textwidth}{@{}YY@{}}
      \toprule
      \poliCabTabela{#3} & \poliCabTabela{#4} \\
      \midrule
      #5
      \bottomrule
    \end{tabularx}
  \end{table}%
}

% \tabelatres{<caption>}{<label>}{<col1>}{<col2>}{<col3>}{<linhas>}
\newcommand{\tabelatres}[6]{%
  \begin{table}[htbp]
    \centering
    \caption{#1}\label{#2}
    \begin{tabularx}{\textwidth}{@{}YYY@{}}
      \toprule
      \poliCabTabela{#3} & \poliCabTabela{#4} & \poliCabTabela{#5} \\
      \midrule
      #6
      \bottomrule
    \end{tabularx}
  \end{table}%
}

