\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{poliusp}[2026/08/16 Template Poli USP v1.2]

% --- 0. OPÇÕES ---
% O núcleo carrega apenas o que todo relatório usa: capa, cabeçalho/rodapé,
% figuras e tabelas. O resto entra sob demanda, para que um relatório curto não
% pague o custo de compilação de amsthm, siunitx, tikz e minted.
%
%   \usepackage[math,units]{poliusp}   % só o que for usar
%   \usepackage[full]{poliusp}         % tudo (equivale à v1.1)
\newif\ifpoli@math
\newif\ifpoli@units
\newif\ifpoli@localtoc
\newif\ifpoli@subfigures
\newif\ifpoli@smartrefs
\newif\ifpoli@floatbarriers
\newif\ifpoli@tikz
\newif\ifpoli@code

\DeclareOption{math}{\poli@mathtrue}
\DeclareOption{units}{\poli@unitstrue}
\DeclareOption{localtoc}{\poli@localtoctrue}
\DeclareOption{subfigures}{\poli@subfigurestrue}
\DeclareOption{smartrefs}{\poli@smartrefstrue}
\DeclareOption{floatbarriers}{\poli@floatbarrierstrue}
\DeclareOption{tikz}{\poli@tikztrue}
\DeclareOption{code}{\poli@codetrue}
\DeclareOption{full}{%
  \poli@mathtrue
  \poli@unitstrue
  \poli@localtoctrue
  \poli@subfigurestrue
  \poli@smartrefstrue
  \poli@floatbarrierstrue
  \poli@tikztrue
  \poli@codetrue
}
\DeclareOption*{\PackageWarning{poliusp}{Opcao desconhecida: \CurrentOption}}
\ProcessOptions\relax

% --- 1. PACOTES ---
\RequirePackage{graphicx}
\RequirePackage{eso-pic}
\RequirePackage{transparent}
\RequirePackage{xcolor}
\RequirePackage{ifthen}
\RequirePackage{fontspec}   % núcleo: a capa depende da Copperplate
\ifpoli@math
  \RequirePackage{amsmath}
  \RequirePackage{amssymb}
  \RequirePackage{amsthm}
\fi
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\ifpoli@units
  \RequirePackage{siunitx}
\fi
\RequirePackage{float}  % compatibilidade com relatórios legados que ainda usam [H]
\ifpoli@floatbarriers
  \RequirePackage[section]{placeins}
\fi
\ifpoli@code
  \RequirePackage{minted}
\fi
\ifpoli@localtoc
  \RequirePackage{etoc}
\fi
\ifpoli@tikz
  \RequirePackage{tikz}
  \usetikzlibrary{tikzmark,calc,shapes,backgrounds,arrows.meta,positioning}
\fi
\RequirePackage[pagestyles]{titlesec}
\RequirePackage[
  top=26mm,
  left=25mm,
  right=25mm,
  headheight=14mm,
  headsep=10mm
]{geometry}

% Em modo twoside o LaTeX usa \flushbottom: estica o espaço vertical para forçar
% todas as páginas à mesma altura, o que em páginas com pouco conteúdo (ou com
% muitos floats) espalha o texto. \raggedbottom deixa a página com altura
% natural: texto encostado no TOPO e a sobra no rodapé.
\raggedbottom

% --- 2. CORES E FONTES ---
\definecolor{azulpoli}{cmyk}{1.0, 0.72, 0.0, 0.18}
\newfontfamily\fonteCapa[
  Path = ./fontes/,
  UprightFont = {copperplate_gothic_bt.ttf},
  BoldFont    = {CopperplateGothicBT-Bold.otf}
]{Copperplate Gothic BT}

\ifpoli@units
  \sisetup{
    output-decimal-marker = {,},  % vírgula decimal (padrão brasileiro)
    group-separator       = {.},  % ponto como separador de milhar
    group-minimum-digits  = 4,
  }
\fi

\RequirePackage[
  colorlinks=true,
  linkcolor=azulpoli,
  citecolor=azulpoli,
  urlcolor=azulpoli,
  pdfdisplaydoctitle=true,
  bookmarksnumbered=true
]{hyperref}

% subcaption e cleveref devem vir após hyperref
\ifpoli@subfigures
  \RequirePackage{subcaption}
\fi
\ifpoli@smartrefs
  \RequirePackage{cleveref}

  \crefname{figure}{Figura}{Figuras}
  \Crefname{figure}{Figura}{Figuras}
  \ifpoli@subfigures
    \crefname{subfigure}{Figura}{Figuras}
    \Crefname{subfigure}{Figura}{Figuras}
  \fi
  \crefname{table}{Tabela}{Tabelas}
  \Crefname{table}{Tabela}{Tabelas}
  \crefname{section}{Seção}{Seções}
  \Crefname{section}{Seção}{Seções}
  \crefname{subsection}{Subseção}{Subseções}
  \Crefname{subsection}{Subseção}{Subseções}
  \ifpoli@math
    \crefname{equation}{Equação}{Equações}
    \Crefname{equation}{Equação}{Equações}
  \fi
\fi

% --- 3. VARIÁVEIS DE METADADOS ---
\newcommand{\poliTituloSalvo}{Titulo do Relatorio}
\newcommand{\poliTituloCurtoSalvo}{Titulo Curto}
\newcommand{\poliSubtituloSalvo}{}
\newcommand{\poliDisciplinaSalva}{}
\newcommand{\poliDepartamentoSalvo}{}
\newcommand{\poliAutoresLista}{}
\newcommand{\poliDataSalva}{\today}
\newboolean{temSubtitulo}\setboolean{temSubtitulo}{false}

\newcommand{\titulo}[2][]{%
  \renewcommand{\poliTituloSalvo}{#2}%
  \ifthenelse{\equal{#1}{}}{%
    \renewcommand{\poliTituloCurtoSalvo}{#2}%
  }{%
    \renewcommand{\poliTituloCurtoSalvo}{#1}%
  }%
}
\newcommand{\subtitulo}[1]{%
  \renewcommand{\poliSubtituloSalvo}{#1}%
  \setboolean{temSubtitulo}{true}%
}
\newcommand{\disciplina}[1]{\renewcommand{\poliDisciplinaSalva}{#1}}
\newcommand{\departamento}[1]{\renewcommand{\poliDepartamentoSalvo}{#1}}
\newcommand{\Autores}[1]{\renewcommand{\poliAutoresLista}{#1}}
\newcommand{\data}[1]{\renewcommand{\poliDataSalva}{#1}}

% --- 4. BLOCO DE AUTORES ---
\newcommand{\poliBlocoAutores}{%
  \begin{minipage}[t]{\textwidth}
    \centering\large
    \poliAutoresLista
  \end{minipage}%
}

% --- 5. SUMÁRIO LOCAL DE SEÇÃO ---  [opção: localtoc]
\ifpoli@localtoc
  \newcommand{\gerarSumarioLocal}{%
    \begingroup
    \etocsettocdepth{subsection}
    \etocsetstyle{section}{}{}{}{}
    \etocsetstyle{subsection}
      {}
      {\leavevmode\leftskip 1.5em \noindent}
      {%
        \textbf{\etocnumber}\hspace{0.5em}%
        \etocname
        \nobreak
        \leaders\hbox to 0.5em{\hss.\hss}\hfill
        \nobreak
        \makebox[1.2em][r]{\textbf{\etocpage}}%
        \hspace{1.5em}%
        \par\vspace{5pt}%
      }
      {}
    \etocsettocstyle
      {%
        \begin{center}\begin{minipage}{0.85\textwidth}
        \noindent\textbf{Seções}
        \par\vspace{1pt}\hrule height 0.6pt\vspace{10pt}%
      }
      {%
        \vspace{5pt}\hrule height 0.6pt
        \end{minipage}\end{center}%
        \vspace{0.5cm}%
      }
    \localtableofcontents
    \endgroup
  }
\fi

% --- 6. CÓDIGO-FONTE (minted) ---  [opção: code]
% minted precisa de LuaLaTeX/pdfLaTeX com -shell-escape e do Pygments; por isso
% fica atrás de uma opção, e não no núcleo.
\ifpoli@code
  % Padrão visual aplicado globalmente a todos os blocos minted
  \setminted{
    fontsize   = \small,
    linenos    = true,
    breaklines = true,
    frame      = lines,
    framesep   = 6pt,
    bgcolor    = gray!6,
    numbersep  = 8pt,
  }

  % Atalhos de linguagem (geram ambientes vhdlcode, pythoncode, ccode)
  \newminted{vhdl}{}
  \newminted{python}{}
  \newminted{c}{}

  \ifpoli@smartrefs
    \crefname{listing}{Código}{Códigos}
    \Crefname{listing}{Código}{Códigos}
  \fi
\fi

% --- 7. AMBIENTES MATEMÁTICOS (amsthm) ---  [opção: math]
\ifpoli@math
  % Estilos visuais consistentes com o template
  \newtheoremstyle{poliPlain}
    {8pt}{6pt}
    {\itshape}{}
    {\color{azulpoli}\fonteCapa\bfseries}{.}
    { }{}

  \newtheoremstyle{poliDefinition}
    {8pt}{6pt}
    {}{}
    {\color{azulpoli}\fonteCapa\bfseries}{.}
    { }{}

  % A Copperplate só tem Regular e Bold: pedir \itshape aqui cairia em
  % substituição silenciosa de fonte. A observação se distingue pelo peso
  % (regular) contra o negrito dos dois estilos acima.
  \newtheoremstyle{poliRemark}
    {6pt}{4pt}
    {}{}
    {\color{azulpoli}\fonteCapa\mdseries}{.}
    { }{}

  % Ambientes numerados por seção
  \theoremstyle{poliPlain}
  \newtheorem{teorema}{Teorema}[section]
  \newtheorem{lema}{Lema}[section]
  \newtheorem{corolario}{Corolário}[section]
  \newtheorem{proposicao}{Proposição}[section]

  \theoremstyle{poliDefinition}
  \newtheorem{definicao}{Definição}[section]
  \newtheorem{exemplo}{Exemplo}[section]

  \theoremstyle{poliRemark}
  \newtheorem*{observacao}{Observação}

  % Renomeia "Proof" para português
  \renewcommand{\proofname}{Demonstração}

  \ifpoli@smartrefs
    \crefname{teorema}{Teorema}{Teoremas}
    \Crefname{teorema}{Teorema}{Teoremas}
    \crefname{lema}{Lema}{Lemas}
    \Crefname{lema}{Lema}{Lemas}
    \crefname{corolario}{Corolário}{Corolários}
    \Crefname{corolario}{Corolário}{Corolários}
    \crefname{proposicao}{Proposição}{Proposições}
    \Crefname{proposicao}{Proposição}{Proposições}
    \crefname{definicao}{Definição}{Definições}
    \Crefname{definicao}{Definição}{Definições}
    \crefname{exemplo}{Exemplo}{Exemplos}
    \Crefname{exemplo}{Exemplo}{Exemplos}
  \fi
\fi

% --- 8. TABELAS AUXILIARES ---
% Todas usam tabularx: colunas X dividem o espaço restante automaticamente.
% Y acrescenta alinhamento à esquerda, evitando os vãos entre palavras que o
% texto justificado abre em colunas estreitas com termos técnicos.
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

% \tabelaSimulacao{<caption>}{<label>}{<linhas>}
\newcommand{\tabelaSimulacao}[3]{%
  \begin{table}[htbp]
    \centering
    \caption{#1}\label{#2}
    \begin{tabularx}{\textwidth}{cYYYY}
      \toprule
      \textbf{(Caso)} & \textbf{Operação} & \textbf{Sinais de entrada} &
      \textbf{Resultado esperado} & \textbf{Resultado observado} \\
      \midrule
      #3
      \bottomrule
    \end{tabularx}
  \end{table}%
}

% \tabeladuas{<caption>}{<label>}{<col1>}{<col2>}{<linhas>}
\newcommand{\tabeladuas}[5]{%
  \begin{table}[htbp]
    \centering
    \caption{#1}\label{#2}
    \begin{tabularx}{\textwidth}{YY}
      \toprule
      \textbf{#3} & \textbf{#4} \\
      \midrule
      #5
      \bottomrule
    \end{tabularx}
  \end{table}%
}

% \tabelatres{<caption>}{<label>}{<col1>}{<col2>}{<col3>}{<linhas>}
\newcommand{\tabelatres}[6]{%
  \begin{table}[htbp]
    \centering
    \caption{#1}\label{#2}
    \begin{tabularx}{\textwidth}{YYY}
      \toprule
      \textbf{#3} & \textbf{#4} & \textbf{#5} \\
      \midrule
      #6
      \bottomrule
    \end{tabularx}
  \end{table}%
}

% --- 9. IMAGENS ---
\newcommand{\poliBrasao}{logospoli/logorobusto}
\newcommand{\poliFilet}{logospoli/polytechnique-filetlongrouge}
\newcommand{\poliBarraLogo}{logospoli/usp+polibarra}
\newcommand{\poliImgCabecalho}{logospoli/nome-colorido}

\newcommand{\MarcaAguaCapa}{%
  \AddToShipoutPictureBG*{%
    \AtPageCenter{%
      \put(0,20mm){\makebox(0,0){%
        {\transparent{0.1}\includegraphics[width=0.5\paperwidth,keepaspectratio]{\poliBrasao}}%
      }}%
    }%
  }%
}

% --- 10. CAPA ---
\renewcommand{\maketitle}{%
  \begin{titlepage}
    \MarcaAguaCapa
    \centering

    % Cabeçalho fixo via eso-pic (não desloca o conteúdo da página)
    \AddToShipoutPictureBG*{%
      \AtPageUpperLeft{%
        \put(\LenToUnit{0.5\paperwidth},\LenToUnit{-2cm}){%
          \makebox(0,0)[t]{%
            \begin{tabular}{c}
              \includegraphics[width=16cm]{\poliImgCabecalho} \\
              \fonteCapa \poliDepartamentoSalvo
            \end{tabular}%
          }%
        }%
      }%
    }

    \vspace*{3.5cm}

    \begin{minipage}[t][12cm][c]{\textwidth}
      \centering
      {\huge\fonteCapa\bfseries\color{azulpoli}\poliTituloSalvo\par}
      \ifthenelse{\boolean{temSubtitulo}}{%
        \vspace{1cm}%
        {\Large\color{azulpoli}\textbf{\poliSubtituloSalvo}\par}%
      }{}
    \end{minipage}

    \vspace{2cm}

    \includegraphics{\poliFilet}
    \vspace{0.2cm}

    \poliBlocoAutores

    \vspace{0.2cm}
    \includegraphics{\poliFilet}

    \vfill
    \ifthenelse{\equal{\poliDisciplinaSalva}{}}{}{%
      {\large\fonteCapa\color{azulpoli}\poliDisciplinaSalva\par}%
      \vspace{0.4cm}%
    }
    {\large\poliDataSalva\par}

  \end{titlepage}
  \clearpage
}

% --- 11. CABEÇALHO E RODAPÉ ---
\newlength{\alturaLogoHeader}
\setlength{\alturaLogoHeader}{10mm}

\newcommand{\poliHeaderTitulo}{%
  \fonteCapa\color{azulpoli}\poliTituloCurtoSalvo%
}
\newcommand{\poliHeaderLogo}{%
  \includegraphics[height=\alturaLogoHeader]{\poliBarraLogo}%
}

% Logo no lado interno, título no lado externo (padrão livro)
\newpagestyle{poliusp}{%
  \sethead[\poliHeaderLogo][][\poliHeaderTitulo]%  páginas pares
          {\poliHeaderTitulo}{}{\poliHeaderLogo}%  páginas ímpares
  \headrule
  \setfoot[][\fonteCapa\color{azulpoli}\thepage][]%  páginas pares
          {}{\fonteCapa\color{azulpoli}\thepage}{}%  páginas ímpares
}

% --- 12. FORMATAÇÃO DE SEÇÕES ---
\renewcommand{\contentsname}{Sumário}

\titleformat{\section}
  {\centering\fonteCapa\bfseries\Large}
  {\thesection}{0.8em}{}

% Mesmo estilo para seções sem número (\section*)
\titleformat{name=\section,numberless}
  {\centering\fonteCapa\bfseries\Large}
  {}{0em}{}

\titleformat{\subsection}
  {\raggedright\fonteCapa\mdseries\large}
  {\thesubsection}{0.8em}{}

\titlespacing*{\section}   {0pt}{2.5ex plus 0.8ex minus 0.4ex}{1.2ex}
\titlespacing*{\subsection}{0pt}{2.0ex plus 0.6ex minus 0.3ex}{0.8ex}

% --- 13. ATIVAÇÃO ---
\AtBeginDocument{%
  \maketitle
  \pagestyle{poliusp}%
}
