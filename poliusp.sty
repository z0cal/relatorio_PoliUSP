\newcommand{\MarcaAguaCapa}{%
  \AddToShipoutPictureBG*{%
    \AtPageUpperLeft{%
      \put(\LenToUnit{0.5\paperwidth},\LenToUnit{-\poliTopoTituloCapa}){%
        \makebox(0,0){%
          {\transparent{0.12}\includegraphics[width=\poliLarguraBrasaoCapa,keepaspectratio]{\poliBrasao}}%
        }%
      }}%
  }%
}

% --- 10. CAPA ---
\renewcommand{\maketitle}{%
  \begin{titlepage}
    \MarcaAguaCapa
    \centering

    % Cabeçalho fixo via eso-pic (não desloca o conteúdo da página)
    \AddToShipoutPictureBG*{%
      \AtPageUpperLeft{%
        \put(\LenToUnit{0.5\paperwidth},\LenToUnit{-2cm}){%
          \makebox(0,0)[t]{%
            \begin{tabular}{c}
              \includegraphics[width=16cm]{\poliImgCabecalho} \\
              \fonteCapa \poliDepartamentoSalvo
            \end{tabular}%
          }%
        }%
      }%
    }

    \poli@posicionarBlocoCapa{\poliTopoTituloCapa}{%
      \begin{minipage}{\poliLarguraTituloCapa}
        \centering
        % 12 pt * phi, com entrelinha de 24 pt.
        {\fonteCapa\bfseries\fontsize{19.4164}{24}\selectfont
          \color{azulpoli}\poliTituloSalvo\par}%
      \end{minipage}%
    }

    \ifthenelse{\boolean{temSubtitulo}}{%
      \poli@posicionarBlocoCapa{\poliTopoSubtituloCapa}{%
        \normalsize\color{azulpoli}\textbf{\poliSubtituloSalvo}\par}%
    }{}

    \poli@posicionarBlocoCapa{\poliTopoAutoresCapa}{%
      \poliOrnamentoAutores\par\vspace{0.3cm}%
      \poliBlocoAutores\par\vspace{0.3cm}%
      \poliOrnamentoAutores\par
    }

    \poli@posicionarBlocoCapa{\poliTopoDataCapa}{%
      \ifthenelse{\equal{\poliDisciplinaSalva}{}}{}{%
        {\normalsize\fonteCapa\color{azulpoli}\poliDisciplinaSalva\par}%
        \vspace{0.4cm}%
      }%
      \normalsize\poliDataSalva\par
    }

    % As camadas acima precisam de uma página de conteúdo para serem enviadas.
    \null\vfill

  \end{titlepage}
  \clearpage
}

% --- 11. CABEÇALHO E RODAPÉ ---
\newlength{\alturaLogoHeader}
\setlength{\alturaLogoHeader}{10mm}

\newcommand{\poliHeaderTitulo}{%
  \normalfont\sffamily\color{azulpoli}\poliTituloCurtoSalvo%
}
\newcommand{\poliHeaderLogo}{%
  \includegraphics[height=\alturaLogoHeader]{\poliBarraLogo}%
}

% Logo no lado interno, título no lado externo (padrão livro)
\newpagestyle{poliusp}{%
  \sethead[\poliHeaderLogo][][\poliHeaderTitulo]%  páginas pares
          {\poliHeaderTitulo}{}{\poliHeaderLogo}%  páginas ímpares
  \headrule
  \setfoot[][\normalfont\color{azulpoli}\thepage][]%  páginas pares
          {}{\normalfont\color{azulpoli}\thepage}{}%  páginas ímpares
}

% --- 12. FORMATAÇÃO DE SEÇÕES ---
\renewcommand{\contentsname}{Sumário}

\titleformat{\section}
  {\centering\normalfont\sffamily\bfseries\Large}
  {\thesection}{0.8em}{}

% Mesmo estilo para seções sem número (\section*)
\titleformat{name=\section,numberless}
  {\centering\normalfont\sffamily\bfseries\Large}
  {}{0em}{}

\titleformat{\subsection}
  {\raggedright\normalfont\sffamily\mdseries\large}
  {\thesubsection}{0.8em}{}

\titlespacing*{\section}   {0pt}{2.5ex plus 0.8ex minus 0.4ex}{1.2ex}
\titlespacing*{\subsection}{0pt}{2.0ex plus 0.6ex minus 0.3ex}{0.8ex}

% --- 13. ATIVAÇÃO ---
\AtBeginDocument{%
  \maketitle
  \pagestyle{poliusp}%
}
